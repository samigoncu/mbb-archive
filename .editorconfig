root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

# Bazı dosyalar 200+ karakterlik tek satırlara sıkıştırılmıştı; aynı depoda
# iki farklı yazım alışkanlığı okumayı ve gözden geçirmeyi zorlaştırıyor.
# Bu sınır editörler ve `dotnet format` tarafından kullanılır.
max_line_length = 140
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_prefer_primary_constructors = false:suggestion
csharp_style_prefer_collection_expression = true:suggestion
dotnet_style_qualification_for_field = false:suggestion

[*.{json,js,jsx,ts,tsx,yml,yaml,css,md}]
indent_style = space
indent_size = 2

[*.{ts,tsx}]
max_line_length = 140
