# Örnek ortam dosyası — `cp .env.example .env` ile kopyalayın.
#
# Buradaki tüm parolalar bilinçli olarak "change-me-*" işaretli yerel
# geliştirme değerleridir. Üretimde bu dosya kullanılmaz; gizli değerler
# secret store'dan verilir. .env dosyası .gitignore ile depo dışında tutulur.

POSTGRES_DB=mbb_archive
POSTGRES_USER=mbb_archive
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

MBB_ARCHIVE_API_URL=http://localhost:5080/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080/api/v1

ConnectionStrings__Documents=Host=localhost;Port=5432;Database=mbb_archive;Username=mbb_archive;Password=change-me-local-only
Documents__FileStaging__RootPath=./.local-data/staging
Documents__FileStaging__MaxUploadBytes=2147483648

RABBITMQ_DEFAULT_USER=mbb_archive
RABBITMQ_DEFAULT_PASS=change-me-local-only
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

RabbitMq__HostName=localhost
RabbitMq__Port=5672
RabbitMq__UserName=mbb_archive
RabbitMq__Password=change-me-local-only

Documents__OriginalStorage__Provider=Local
Documents__OriginalStorage__LocalRootPath=./.local-data/originals

# Production S3-compatible example:
# Documents__OriginalStorage__Provider=S3
# Documents__OriginalStorage__S3__BucketName=mbb-archive-originals
# Documents__OriginalStorage__S3__ServiceUrl=https://s3.example.local
# Documents__OriginalStorage__S3__Region=us-east-1
# Documents__OriginalStorage__S3__ForcePathStyle=true
# Documents__OriginalStorage__S3__AccessKey=
# Documents__OriginalStorage__S3__SecretKey=

ConnectionStrings__Processing=Host=localhost;Port=5432;Database=mbb_archive;Username=mbb_archive;Password=change-me-local-only

# Python processing workers
OCR_PROVIDER=tesseract
OCR_LANGUAGES=tur+eng
OCR_RENDER_DPI=200
OCR_SEARCHABLE_PDF_ENABLED=false

ConnectionStrings__Classification=Host=localhost;Port=5432;Database=mbb_archive;Username=mbb_archive;Password=change-me-local-only

ConnectionStrings__Search=Host=localhost;Port=5432;Database=mbb_archive;Username=mbb_archive;Password=change-me-local-only
Search__OpenSearch__BaseUrl=http://localhost:9200
Search__Artifacts__Provider=Local
Search__Artifacts__LocalRootPath=./.local-data/artifacts

ConnectionStrings__Archive=Host=localhost;Port=5432;Database=mbb_archive;Username=mbb_archive;Password=change-me-local-only
ConnectionStrings__Retention=Host=localhost;Port=5432;Database=mbb_archive;Username=mbb_archive;Password=change-me-local-only
ConnectionStrings__AccessControl=Host=localhost;Port=5432;Database=mbb_archive;Username=mbb_archive;Password=change-me-local-only
ConnectionStrings__Audit=Host=localhost;Port=5432;Database=mbb_archive;Username=mbb_archive;Password=change-me-local-only
ConnectionStrings__Workflow=Host=localhost;Port=5432;Database=mbb_archive;Username=mbb_archive;Password=change-me-local-only
Security__Authentication__Enabled=false
# Production:
# Security__Authentication__Enabled=true
# Security__Authentication__Authority=https://identity.example.gov.tr
# Security__Authentication__Audience=mbb-archive-api

ConnectionStrings__PhysicalArchive=Host=localhost;Port=5432;Database=mbb_archive;Username=mbb_archive;Password=change-me-local-only

ConnectionStrings__Evidence=Host=localhost;Port=5432;Database=mbb_archive;Username=mbb_archive;Password=change-me-local-only
ConnectionStrings__OfficialCorrespondence=Host=localhost;Port=5432;Database=mbb_archive;Username=mbb_archive;Password=change-me-local-only

# RFC 3161 TSA - kurumun yetkili zaman damgası servisine göre doldurulur.
Evidence__TimestampAuthority__Url=
Evidence__TimestampAuthority__HashAlgorithm=SHA256
Evidence__TimestampAuthority__TimeoutSeconds=30

ConnectionStrings__Operations=Host=localhost;Port=5432;Database=mbb_archive;Username=mbb_archive;Password=change-me-local-only

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=Mbb.Archive.Api

Operations__Probes__RabbitMq__BaseUrl=http://localhost:15672
Operations__Probes__RabbitMq__UserName=mbb_archive
Operations__Probes__RabbitMq__Password=change-me-local-only
Operations__Probes__OpenSearch__BaseUrl=http://localhost:9200

Documents__Fixity__SampleSize=25

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-observability-only