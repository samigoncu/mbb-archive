# `cp web/.env.example web/.env` ile kopyalayın.

# Sunucu tarafındaki API adresi. Tarayıcı API'ye doğrudan gitmez; tüm
# istekler Next sunucusundan, oturum jetonu eklenerek iletilir.
MBB_ARCHIVE_API_URL=http://localhost:5080/api/v1

# --- Kurum kimlik sağlayıcısı (OIDC) ---
# Bu iki değer boşken kimlik doğrulama devre dışıdır ve uygulama API'nin
# geliştirme kimliğiyle çalışır. Üretimde ikisi de doldurulmalıdır.
# Gerçek değerler kaynak koda yazılmaz; ortam değişkeni/secret ile verilir (§0.11).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email groups offline_access

# Uygulamanın dış adresi; OIDC yönlendirme adresi bundan türetilir.
APP_BASE_URL=http://localhost:3000

# Oturum çerezinin şifreleme anahtarı. En az 32 karakter olmalıdır.
# Üretimde rastgele üretin: openssl rand -base64 48
AUTH_SECRET=
